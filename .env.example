# AgenticGTM API Keys
# Rename this file to .env and fill in your keys

# LLM Backbone
GEMINI_API_KEY=your_gemini_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agenticgtm

# Social Media APIs (Optional for initial build)
TWITTER_API_KEY=
LINKEDIN_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Payments
STRIPE_SECRET_KEY=

# SEO Blogging API
DEVTO_API_KEY=your_devto_key_here

